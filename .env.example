# Copy this to .env.local and fill in your Supabase credentials
# Get these from: https://supabase.com → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# This is only used server-side (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend (email notifications) — get your key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# The "from" address for outgoing emails (must be verified in Resend)
EMAIL_FROM=LeaveFlow <noreply@yourdomain.com>

# Your app's public URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
